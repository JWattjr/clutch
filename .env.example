NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_RPC_URL=https://studio.genlayer.com/api
CLUTCH_RPC_URL=https://studio.genlayer.com/api
CLUTCH_BROWSER_EXECUTABLE=

# Each key belongs to a dedicated throwaway Studionet wallet. Never use a
# sibling project's key or a wallet holding valuable assets.
CLUTCH_DEPLOYER_PRIVATE_KEY=
CLUTCH_CONTRACT_ADDRESS=
CLUTCH_DEMO_PRIVATE_KEY=
CLUTCH_ALLOW_STUDIONET_WRITES=
CLUTCH_ALLOW_VALIDATOR_PROBE_WRITES=
CLUTCH_SEED_DESCRIPTION=
CLUTCH_SEED_REWARD=25

# Live integration preflight. The Lichess ID and game ID are public identifiers.
CLUTCH_PROBE_SPONSOR_PRIVATE_KEY=
CLUTCH_PROBE_PLAYER_PRIVATE_KEY=
CLUTCH_PROBE_LICHESS_ID=
CLUTCH_PROBE_GAME_ID=
CLUTCH_INTEGRATION_RUN_ID=local-trial
CLUTCH_PROOF_CLAIM_ID=
CLUTCH_PROOF_TX_HASH=

# Public address of the separate casual BOT demo deployment.
NEXT_PUBLIC_BOT_DEMO_CONTRACT_ADDRESS=
CLUTCH_BOT_DEMO_CONTRACT_ADDRESS=

# Local operator only. Prefer .env.bot-demo, created by npm run demo:bot -- init.
# Token scope: bot:play. Both accounts must already have the BOT title.
CLUTCH_BOT_WHITE_TOKEN=
CLUTCH_BOT_BLACK_TOKEN=
CLUTCH_BOT_SPONSOR_PRIVATE_KEY=
CLUTCH_BOT_PLAYER_PRIVATE_KEY=
CLUTCH_BOT_WHITE_ID=
CLUTCH_BOT_BLACK_ID=
